{
  "$schema": "https://raw.githubusercontent.com/jetify-com/devbox/0.17.0/.schema/devbox.schema.json",
  "packages": [
    "go@1.25",
    "gotestsum@latest"
  ],
  "shell": {
    "init_hook": [],
    "scripts": {
      "build": "go build ./...",
      "test": "make test",
      "test:watch": "gotestsum --watch ./...",
      "test:cover": "make test-cover",
      "vet": "go vet ./..."
    }
  }
}
